<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131C"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/displayExpression"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:maxLines="2"
        android:padding="8dp"
        android:textColor="#9BA3B7"
        android:textSize="24sp"
        android:contentDescription="@string/calculator_description" />

    <TextView
        android:id="@+id/displayResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:minHeight="88dp"
        android:padding="8dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif-light" />

    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="false">

        <Button
            android:id="@+id/buttonClear"
            style="@style/CalculatorFunctionButton"
            android:text="@string/clear"
            android:layout_row="0"
            android:layout_column="0" />

        <Button
            android:id="@+id/buttonBackspace"
            style="@style/CalculatorFunctionButton"
            android:text="@string/backspace"
            android:contentDescription="Backspace"
            android:layout_row="0"
            android:layout_column="1" />

        <Button
            android:id="@+id/buttonDivide"
            style="@style/CalculatorOperatorButton"
            android:text="@string/divide"
            android:layout_row="0"
            android:layout_column="2" />

        <Button
            android:id="@+id/buttonMultiply"
            style="@style/CalculatorOperatorButton"
            android:text="@string/multiply"
            android:layout_row="0"
            android:layout_column="3" />

        <Button
            android:id="@+id/buttonSeven"
            style="@style/CalculatorNumberButton"
            android:text="@string/seven"
            android:layout_row="1"
            android:layout_column="0" />

        <Button
            android:id="@+id/buttonEight"
            style="@style/CalculatorNumberButton"
            android:text="@string/eight"
            android:layout_row="1"
            android:layout_column="1" />

        <Button
            android:id="@+id/buttonNine"
            style="@style/CalculatorNumberButton"
            android:text="@string/nine"
            android:layout_row="1"
            android:layout_column="2" />

        <Button
            android:id="@+id/buttonSubtract"
            style="@style/CalculatorOperatorButton"
            android:text="@string/subtract"
            android:layout_row="1"
            android:layout_column="3" />

        <Button
            android:id="@+id/buttonFour"
            style="@style/CalculatorNumberButton"
            android:text="@string/four"
            android:layout_row="2"
            android:layout_column="0" />

        <Button
            android:id="@+id/buttonFive"
            style="@style/CalculatorNumberButton"
            android:text="@string/five"
            android:layout_row="2"
            android:layout_column="1" />

        <Button
            android:id="@+id/buttonSix"
            style="@style/CalculatorNumberButton"
            android:text="@string/six"
            android:layout_row="2"
            android:layout_column="2" />

        <Button
            android:id="@+id/buttonAdd"
            style="@style/CalculatorOperatorButton"
            android:text="@string/add"
            android:layout_row="2"
            android:layout_column="3" />

        <Button
            android:id="@+id/buttonOne"
            style="@style/CalculatorNumberButton"
            android:text="@string/one"
            android:layout_row="3"
            android:layout_column="0" />

        <Button
            android:id="@+id/buttonTwo"
            style="@style/CalculatorNumberButton"
            android:text="@string/two"
            android:layout_row="3"
            android:layout_column="1" />

        <Button
            android:id="@+id/buttonThree"
            style="@style/CalculatorNumberButton"
            android:text="@string/three"
            android:layout_row="3"
            android:layout_column="2" />

        <Button
            android:id="@+id/buttonZero"
            style="@style/CalculatorNumberButton"
            android:text="@string/zero"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnSpan="2" />

        <Button
            android:id="@+id/buttonDecimal"
            style="@style/CalculatorNumberButton"
            android:text="@string/decimal"
            android:layout_row="4"
            android:layout_column="2" />

        <Button
            android:id="@+id/buttonEquals"
            style="@style/CalculatorOperatorButton"
            android:text="@string/equals"
            android:layout_row="3"
            android:layout_column="3"
            android:layout_rowSpan="2" />

    </GridLayout>

</LinearLayout>
